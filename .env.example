# Copy this file to .env and fill it in.

# Database password. Generate one with: openssl rand -hex 24
DB_PASSWORD=

# The address you open Clarity at, without a trailing slash. Must match the
# redirect URL of your Enable Banking application minus /connect/callback.
# Local only:      http://localhost:8080
# Behind HTTPS:    https://clarity.example.com
PUBLIC_URL=http://localhost:8080

# From the Enable Banking control panel, see docs/enable-banking.md.
# The key file goes to secrets/enable-banking.pem.
ENABLE_BANKING_APPLICATION_ID=

# Only for testing without HTTPS, see docs/enable-banking.md. Leave empty
# otherwise; the redirect URL is then PUBLIC_URL + /connect/callback.
BANKING_REDIRECT_URL=

# Where the panel listens. Keep 127.0.0.1 unless you know why not.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Server only (docs/server.md): use the published images and Caddy for TLS.
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# CLARITY_DOMAIN=clarity.example.com
# Caddy's own ports; the edge proxy forwards to them. Pick free ones.
# CLARITY_HTTP_PORT=8089
# CLARITY_HTTPS_PORT=8444
# Only reachable at home (the domain points at a local address): Caddy signs
# its own certificate; install its root once on every device.
# CLARITY_TLS=tls internal
